{
  "name": "@openeos/ui",
  "version": "0.3.3",
  "description": "OpenEOS Designsystem — Tokens, Klassenbibliothek und React-Komponenten für Admin, POS, Shop und Displays",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenEOS-Project/openeos-ui.git"
  },
  "homepage": "https://github.com/OpenEOS-Project/openeos-ui#readme",
  "bugs": {
    "url": "https://github.com/OpenEOS-Project/openeos-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./fonts": "./src/fonts.ts",
    "./styles.css": "./dist/styles.css",
    "./css/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/styles",
    "src/fonts.ts",
    "src/fonts/files",
    "!**/.omc"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "openeos",
    "design-system",
    "pos",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.6"
}
